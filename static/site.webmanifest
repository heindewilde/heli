{
  "name": "Heli",
  "short_name": "Heli",
  "description": "Heli is an open-source CRM that keeps clients, deals, and projects organized in one calm workspace. Simple, lightweight, and surprisingly powerful.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f6f8fc",
  "theme_color": "#f6f8fc",
  "icons": [
    { "src": "/web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/web-app-manifest-512x512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/save",
    "method": "GET",
    "params": { "url": "url", "text": "text", "title": "title" }
  }
}
