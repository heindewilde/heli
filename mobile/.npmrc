# The repo root sets `engine-strict=true`, and npm reads .npmrc upward from the
# install directory — so without this file the app's Node policy applies to the
# Expo dependency tree, where several packages declare engine ranges that do not
# match and would fail `npm ci` here for no reason.
#
# This is the mobile equivalent of the isolation that `.dockerignore` and the
# root tsconfig `exclude` give the extension: mobile/ is deliberately not an npm
# workspace, so it gets to have its own toolchain policy.
engine-strict=false
