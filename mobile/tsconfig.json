{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    "nativewind-env.d.ts",
    "../src/lib/cleanUrl.ts",
    "../src/lib/duration.ts",
    "../src/lib/weeks.ts",
    "../src/lib/dates.ts",
    "../src/lib/initials.ts",
    "../src/lib/url.ts",
    "../src/lib/polling.ts",
    "../src/lib/branding.ts",
    "../src/lib/richText.ts",
    "../src/lib/priority.ts",
    "../src/lib/statuses.ts",
    "../src/lib/stageColors.ts",
    "../src/lib/projectColor.ts",
    "../src/lib/projectTypes.ts",
    "../src/lib/interactionTypes.ts",
    "../src/lib/interactionMeta.ts",
    "../src/lib/collectionIconNames.ts",
    "../src/lib/commands/fuzzy.ts",
    "../src/lib/outreach/render.ts",
    "../src/lib/outreach/platforms.ts",
    "../src/lib/outreach/deepLink.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
